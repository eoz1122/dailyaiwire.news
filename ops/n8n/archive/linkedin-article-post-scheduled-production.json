    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nstaticData.processedIds = staticData.processedIds || [];\n\nconst articleId = $json.link;\nif (!articleId) {\n  return [];\n}\n\nif (staticData.processedIds.includes(articleId)) {\n  return [];\n}\n\nstaticData.processedIds.push(articleId);\nif (staticData.processedIds.length > 200) {\n  staticData.processedIds = staticData.processedIds.slice(-200);\n}\n\nreturn [{ json: { ...$json, articleId } }];"
      },
      "id": "dedupe-1",
      "name": "Skip Already Processed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1180,
        240
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "fmt-1",
              "name": "postText",
              "value": "={{ (() => { const title = ($json.title || 'Latest AI Update').toString().trim(); const categoryValue = (($json.categories && $json.categories[0]) || $json.category || 'AI News').toString().trim(); const raw = ($json.contentSnippet || '').toString().replace(/\\r/g, '').trim(); const paragraphs = raw.split(/\\n\\n/).map(p => p.trim()).filter(Boolean); const firstParagraph = paragraphs[0] || ''; const whyMatch = raw.match(/Why it matters:\\s*([\\s\\S]*?)(?:\\n\\n🤔|\\n\\n#|$)/i); const questionMatch = raw.match(/🤔\\s*([\\s\\S]*?)(?:\\n\\n#|$)/); const why = whyMatch ? whyMatch[1].trim() : ''; const question = questionMatch ? questionMatch[1].trim() : ''; const lastParagraph = paragraphs[paragraphs.length - 1] || ''; const directHashTags = raw.match(/#[A-Za-z][A-Za-z0-9]+/g) || []; const bareTags = directHashTags.length ? [] : (lastParagraph.split(/\\s+/).filter(Boolean).filter(token => /^#?[A-Za-z][A-Za-z0-9]+$/.test(token)));\nconst normalizedSpecificTags = (directHashTags.length ? directHashTags : (bareTags.length >= 3 ? bareTags : [])).map(tag => tag.startsWith('#') ? tag : `#${tag}`).filter((v, i, a) => v && a.indexOf(v) === i);\nconst categoryTagBase = categoryValue.replace(/[^A-Za-z0-9]+/g, ''); const fallbackTags = ['#DailyAIWire', '#AI', categoryTagBase ? `#${categoryTagBase}` : ''].filter((v, i, a) => v && a.indexOf(v) === i); const tags = (normalizedSpecificTags.length ? normalizedSpecificTags : fallbackTags).join(' '); const parts = [title, `🛰️ [${categoryValue.toUpperCase()}]`]; if (firstParagraph) parts.push(firstParagraph); if (why) parts.push(`Why it matters:\\n${why}`); if (question) parts.push(`🤔 ${question}`); if (tags) parts.push(tags); parts.push('📡 Follow DailyAIWire for high-signal AI news.'); return parts.filter(Boolean).join('\\n\\n').slice(0, 2500); })() }}",
              "type": "string"
            },
            {
              "id": "fmt-2",
              "name": "postUrl",
              "value": "={{ $json.link }}",
              "type": "string"
            },
            {
              "id": "fmt-3",
              "name": "articleTitle",
              "value": "={{ ($json.title || 'Latest AI Update').toString().slice(0, 200) }}",
              "type": "string"
            },
            {
              "id": "fmt-4",
              "name": "articleDescription",
              "value": "={{ (($json.contentSnippet || '').toString().replace(/\\s+/g, ' ').trim()).slice(0, 300) }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
