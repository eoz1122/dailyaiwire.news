# DailyAIWire.news Environment Configuration
# Copy this file to .env and fill in your actual values

# Gemini API Key (Required)
GEMINI_API_KEY=your_gemini_api_key_here

# Monthly Budget Cap (in USD) - Default: $10
MONTHLY_BUDGET_USD=10.0
# Admin Dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_something_secure
SECRET_KEY=generate_a_long_random_string_here

# Domain Configuration
DOMAIN=dailyaiwire.news

# Flask Configuration
FLASK_ENV=production
SECRET_KEY=your-secret-key-here-generate-with-python-secrets

# Database
DATABASE_PATH=news.db

# Optional: Email for notifications
ADMIN_EMAIL=admin@dailyaiwire.news

# Google Cloud (Required for Audio)
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account.json

# YouTube API (Optional)
# Place client_secret.json in the root directory

# Instagram Graph API (Optional)
IG_USER_ID=your_instagram_user_id
IG_ACCESS_TOKEN=your_long_lived_access_token
