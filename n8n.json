                            "id": "id-1",
                            "name": "postText",
                            "value": "={{ \n  (() => {\n    // Unicode bolding function for the title\n    const toBold = (t) => [...t].map(c => {\n      const code = c.codePointAt(0);\n      if (code >= 65 && code <= 90) return String.fromCodePoint(code + 120211); \n      if (code >= 97 && code <= 122) return String.fromCodePoint(code + 120205); \n      if (code >= 48 && code <= 57) return String.fromCodePoint(code + 120734);  \n      return c;\n    }).join('');\n\n    const boldTitle = toBold($json.title || \"Latest AI Update\");\n    \n    // Tech-focused Category Emoji\n    const category = $json.categories && $json.categories[0] ? `🛰️ [${$json.categories[0].toUpperCase()}]` : '🛰️ [ AI NEWS ]';\n    \n    // Append UTM Parameters to the link\n    const utmParams = \"?utm_source=linkedin&utm_medium=social&utm_campaign=dailyaiwire_automation\";\n    const trackedLink = `${$json.link}${utmParams}`;\n    \n    const footer = \"📡 Follow DailyAIWire for autonomous AI news\";\n    \n    return `${boldTitle}\\n\\n${category}\\n\\n${$json.contentSnippet}\\n\\n${footer}\\n\\n🔗 ${trackedLink}`;\n  })() \n}}",
                            "type": "string"
                        },
