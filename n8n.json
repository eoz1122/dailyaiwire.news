        {
            "parameters": {
                "jsCode": "// 1. Access the workflow's persistent memory\nconst staticData = $getWorkflowStaticData('global');\nstaticData.processedIds = staticData.processedIds || [];\n\n// 2. We will store the articles that pass our \"New Content\" test here\nconst newArticles = [];\n\n// 3. Loop through all incoming articles (the entire batch)\nfor (const item of $input.all()) {\n    const articleId = item.json.link;\n\n    // Check if this specific link is in our memory\n    if (!staticData.processedIds.includes(articleId)) {\n        // If it's new, add it to our \"Memory\"\n        staticData.processedIds.push(articleId);\n        \n        // Add the actual article data to our output list\n        newArticles.push(item);\n    }\n}\n\n// 4. Keep the memory clean (Keep only the last 100 IDs)\nif (staticData.processedIds.length > 100) {\n    staticData.processedIds = staticData.processedIds.slice(-100);\n}\n\n// 5. Output only the new, unique articles\nreturn newArticles;"
            },
            "type": "n8n-nodes-base.code",
